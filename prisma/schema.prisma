generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum SolicitudStatus {
  PENDIENTE
  EN_REVISION
  APROBADA
  RECHAZADA
}

enum SocioStatus {
  ACTIVO
  SUSPENDIDO
  INACTIVO
}

enum Sector {
  ASEGURADORA
  CONCESIONARIA
  RENTING
  LEASING
  FLOTA_CORPORATIVA
  TALLER_AUTORIZADO
  OTRO
}

enum CotizacionStatus {
  PENDIENTE
  ENVIADA
  ACEPTADA
  RECHAZADA
  EXPIRADA
}

enum PedidoStatus {
  PENDIENTE
  CONFIRMADO
  EN_PROCESO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum FacturaStatus {
  PENDIENTE
  PAGADA
  VENCIDA
  ANULADA
}

enum MovimientoTipo {
  CREDITO_ASIGNADO
  CREDITO_UTILIZADO
  CREDITO_LIBERADO
  PAGO_RECIBIDO
}

enum TipoPago {
  CREDITO
  CONTADO
}

enum SolicitudRepuestoStatus {
  PENDIENTE
  EN_PROCESO
  COMPLETADA
  CANCELADA
}

enum NotificacionTipo {
  SOLICITUD_RECIBIDA
  SOLICITUD_APROBADA
  SOLICITUD_RECHAZADA
  COTIZACION_NUEVA
  COTIZACION_RESPONDIDA
  PEDIDO_CONFIRMADO
  PEDIDO_ENVIADO
  FACTURA_EMITIDA
  CREDITO_ACTUALIZADO
  SISTEMA
}

model Administrador {
  id           String   @id @default(cuid())
  nombre       String
  apellido     String
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  logs         AuditLog[]

  @@map("administradores")
}

model Solicitud {
  id                 String          @id @default(cuid())
  razonSocial        String
  ruc                String          @unique
  emailCorporativo   String
  telefono           String
  sector             Sector
  representanteLegal String
  cargo              String
  mensaje            String?
  status             SolicitudStatus @default(PENDIENTE)
  motivoRechazo      String?
  revisadoPor        String?
  revisadoAt         DateTime?
  tokenDocumentos    String?         @unique
  documentosAt       DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  socio              Socio?
  documentos         DocumentoCredito[]

  @@map("solicitudes")
}

model DocumentoCredito {
  id          String   @id @default(cuid())
  solicitudId String
  tipo        String
  nombre      String
  url         String
  createdAt   DateTime @default(now())

  solicitud   Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  @@map("documentos_credito")
}

model Socio {
  id                 String      @id @default(cuid())
  solicitudId        String      @unique
  razonSocial        String
  ruc                String      @unique
  emailCorporativo   String      @unique
  telefono           String
  sector             Sector
  representanteLegal String
  cargo              String
  passwordHash       String
  status             SocioStatus @default(ACTIVO)
  tipoPago           TipoPago    @default(CREDITO)
  plazoCredito       Int         @default(30)
  lineaCredito       Decimal     @default(0) @db.Decimal(12, 2)
  creditoUtilizado   Decimal     @default(0) @db.Decimal(12, 2)
  logoUrl            String?
  direccion          String?
  ciudad             String?
  ultimoAcceso       DateTime?
  passwordCambiado   Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  solicitud          Solicitud         @relation(fields: [solicitudId], references: [id])
  cotizaciones          Cotizacion[]
  pedidos               Pedido[]
  facturas              Factura[]
  notificaciones        Notificacion[]
  movimientos           MovimientoCredito[]
  solicitudesRepuesto   SolicitudRepuesto[]

  @@map("socios")
}

model Categoria {
  id          String     @id @default(cuid())
  nombre      String     @unique
  descripcion String?
  slug        String     @unique
  orden       Int        @default(0)
  activo      Boolean    @default(true)
  createdAt   DateTime   @default(now())

  productos   Producto[]

  @@map("categorias")
}

model Marca {
  id        String     @id @default(cuid())
  nombre    String     @unique
  logoUrl   String?
  activo    Boolean    @default(true)
  createdAt DateTime   @default(now())

  productos Producto[]

  @@map("marcas")
}

model Producto {
  id                 String   @id @default(cuid())
  codigo             String   @unique
  nombre             String
  descripcion        String?
  imagenUrl          String?
  imagenesUrls       String[]
  categoriaId        String
  marcaId            String
  modelosCompatibles String[]
  precio             Decimal  @db.Decimal(10, 2)
  stock              Int      @default(0)
  stockMinimo        Int      @default(5)
  unidad             String   @default("und")
  activo             Boolean  @default(true)
  destacado          Boolean  @default(false)
  orden              Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  categoria          Categoria      @relation(fields: [categoriaId], references: [id])
  marca              Marca          @relation(fields: [marcaId], references: [id])
  cotizacionItems    CotizacionItem[]
  pedidoItems        PedidoItem[]

  @@map("productos")
}

model Cotizacion {
  id          String           @id @default(cuid())
  numero      String           @unique
  socioId     String
  status      CotizacionStatus @default(PENDIENTE)
  notas       String?
  respuesta   String?
  validaHasta DateTime?
  total       Decimal?         @db.Decimal(12, 2)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  socio       Socio            @relation(fields: [socioId], references: [id])
  items       CotizacionItem[]
  pedido      Pedido?

  @@map("cotizaciones")
}

model CotizacionItem {
  id           String   @id @default(cuid())
  cotizacionId String
  productoId   String
  cantidad     Int
  precioUnit   Decimal? @db.Decimal(10, 2)
  subtotal     Decimal? @db.Decimal(12, 2)
  notas        String?

  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  producto     Producto   @relation(fields: [productoId], references: [id])

  @@map("cotizacion_items")
}

model Pedido {
  id               String       @id @default(cuid())
  numero           String       @unique
  socioId          String
  cotizacionId     String?      @unique
  status           PedidoStatus @default(PENDIENTE)
  direccionEntrega String?
  fechaEntrega     DateTime?
  notas            String?
  ocUrl            String?
  ocNumero         String?
  subtotal         Decimal      @db.Decimal(12, 2)
  igv              Decimal      @db.Decimal(12, 2)
  total            Decimal      @db.Decimal(12, 2)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  socio              Socio              @relation(fields: [socioId], references: [id])
  cotizacion         Cotizacion?        @relation(fields: [cotizacionId], references: [id])
  items              PedidoItem[]
  factura            Factura?
  solicitudRepuesto  SolicitudRepuesto?

  @@map("pedidos")
}

model PedidoItem {
  id          String   @id @default(cuid())
  pedidoId    String
  productoId  String?
  descripcion String?
  cantidad    Int
  precioUnit  Decimal  @db.Decimal(10, 2)
  costoUnit   Decimal? @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(12, 2)

  pedido      Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto    Producto? @relation(fields: [productoId], references: [id])

  @@map("pedido_items")
}

// Ventas de mostrador / contado (clientes finales que no están en el sistema).
// Solo Super Admin. items = JSON [{descripcion, codigo, cantidad, precioUnit, costoUnit}]
model VentaMostrador {
  id         String   @id @default(cuid())
  numero     String   @unique
  cliente    String?
  fecha      DateTime @default(now())
  total      Decimal  @db.Decimal(12, 2)
  costoTotal Decimal  @default(0) @db.Decimal(12, 2)
  ganancia   Decimal  @default(0) @db.Decimal(12, 2)
  items      Json
  notas      String?
  createdAt  DateTime @default(now())

  @@map("ventas_mostrador")
}

// Gastos del negocio — solo Super Admin. Alimenta la utilidad neta.
model Gasto {
  id          String   @id @default(cuid())
  fecha       DateTime @default(now())
  categoria   String
  monto       Decimal  @db.Decimal(12, 2)
  descripcion String?
  createdAt   DateTime @default(now())

  @@map("gastos")
}

model SolicitudRepuesto {
  id          String                  @id @default(cuid())
  numero      String                  @unique
  socioId     String
  marcaVehiculo String?
  modeloVehiculo String?
  anioVehiculo  String?
  descripcion String
  cantidad    Int                     @default(1)
  notas       String?
  status      SolicitudRepuestoStatus @default(PENDIENTE)
  pedidoId    String?                 @unique
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  socio       Socio   @relation(fields: [socioId], references: [id])
  pedido      Pedido? @relation(fields: [pedidoId], references: [id])

  @@map("solicitudes_repuesto")
}

model Factura {
  id               String        @id @default(cuid())
  numero           String        @unique
  socioId          String
  pedidoId         String        @unique
  status           FacturaStatus @default(PENDIENTE)
  fechaVencimiento DateTime
  subtotal         Decimal       @db.Decimal(12, 2)
  igv              Decimal       @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)
  pdfUrl           String?
  numeroReal       String?
  pagadoAt         DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  socio            Socio   @relation(fields: [socioId], references: [id])
  pedido           Pedido  @relation(fields: [pedidoId], references: [id])

  @@map("facturas")
}

model MovimientoCredito {
  id           String         @id @default(cuid())
  socioId      String
  tipo         MovimientoTipo
  monto        Decimal        @db.Decimal(12, 2)
  saldoAntes   Decimal        @db.Decimal(12, 2)
  saldoDespues Decimal        @db.Decimal(12, 2)
  descripcion  String
  referenciaId String?
  createdAt    DateTime       @default(now())

  socio        Socio          @relation(fields: [socioId], references: [id])

  @@map("movimientos_credito")
}

model Notificacion {
  id        String           @id @default(cuid())
  socioId   String?
  tipo      NotificacionTipo
  titulo    String
  mensaje   String
  leida     Boolean          @default(false)
  url       String?
  createdAt DateTime         @default(now())

  socio     Socio?           @relation(fields: [socioId], references: [id])

  @@map("notificaciones")
}

model AuditLog {
  id              String   @id @default(cuid())
  administradorId String?
  accion          String
  entidad         String
  entidadId       String?
  datosAntes      Json?
  datosDespues    Json?
  ip              String?
  userAgent       String?
  createdAt       DateTime @default(now())

  administrador   Administrador? @relation(fields: [administradorId], references: [id])

  @@map("audit_logs")
}
